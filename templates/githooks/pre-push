#!/bin/sh
# The default branch is PR-only. This client-side hook is the local first line: the
# repository ruleset refuses direct pushes server-side, and that ruleset is the law. The
# hook does two things:
#
#   1. Blocks any direct push to the default branch, force-pushes and deletion included.
#   2. Runs the static gate (format:check, lint, type-check, whichever of those scripts
#      exist) before any branch push, so a red push never reaches CI. The full test suite
#      stays with CI and the local gate: tests often need a database that remote sessions
#      do not have.
#
# Enable it by pointing git at the directory (and have the package manager's "prepare"
# script run this so that every clone gets it):
#
#     git config core.hooksPath .githooks
#
# Human emergency overrides (agents: never use these, fix the problem instead):
#   ALLOW_DIRECT_PUSH=1 git push ...   # direct push to the default branch
#   SKIP_PUSH_GATE=1 git push ...      # skip the static gate

PROTECTED_BRANCH="{{DEFAULT_BRANCH}}"

gate_needed=0
while read -r _local_ref local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/$PROTECTED_BRANCH" ] && [ "${ALLOW_DIRECT_PUSH:-}" != "1" ]; then
    echo "pre-push: direct push to $PROTECTED_BRANCH is blocked: it only changes through a PR approved by the human." >&2
    echo "pre-push: (emergency override for humans: ALLOW_DIRECT_PUSH=1 git push ...)" >&2
    exit 1
  fi
  # A branch deletion pushes an all-zero local sha: nothing to verify.
  case "$remote_ref" in
    refs/heads/*)
      case "$local_sha" in
        *[!0]*) gate_needed=1 ;;
      esac
      ;;
  esac
done

if [ "$gate_needed" != "1" ] || [ "${SKIP_PUSH_GATE:-}" = "1" ]; then
  exit 0
fi

if ! command -v pnpm >/dev/null 2>&1 || [ ! -d node_modules ]; then
  echo "pre-push: the static gate needs an installed toolchain: run 'pnpm install' first." >&2
  exit 1
fi

# Only run a script the project defines, so this hook is the same file in every repository.
has_script() {
  node -e "process.exit(require('./package.json').scripts && require('./package.json').scripts['$1'] ? 0 : 1)" 2>/dev/null
}

GATE_SCRIPTS=""
for script in format:check lint type-check; do
  has_script "$script" && GATE_SCRIPTS="${GATE_SCRIPTS:+$GATE_SCRIPTS, }$script"
done

if [ -z "$GATE_SCRIPTS" ]; then
  exit 0
fi

echo "pre-push: static gate ($GATE_SCRIPTS)..."
# A loop with an early return rather than `! a && b && c`: in that form `!` inverts only
# `a` and lets a red lint or type-check through. The gate fails if ANY check fails.
run_gate() {
  for script in format:check lint type-check; do
    if has_script "$script"; then
      pnpm run "$script" || return 1
    fi
  done
  return 0
}

if ! run_gate; then
  echo "pre-push: static gate failed ($GATE_SCRIPTS): fix what the red check reported, then push again." >&2
  echo "pre-push: (emergency override for humans: SKIP_PUSH_GATE=1 git push ...)" >&2
  exit 1
fi

exit 0
